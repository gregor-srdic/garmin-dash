<resources xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://developer.garmin.com/downloads/connect-iq/resources.xsd">
    <!-- W' balance only. NP, IF, TSS and work are already written to the
         session natively by the Edge; recording them again would show each
         twice in Garmin Connect with slightly different values. Ids match the
         FIT_* constants in DashView. -->
    <fitContributions>
        <fitField id="0"
        displayInChart="true"
        sortOrder="0"
        precision="1"
        chartTitle="@Strings.wbalChartTitle"
        dataLabel="@Strings.wbalLabel"
        unitLabel="@Strings.kjUnits"
        fillColor="#9900FF" />

        <fitField id="1"
        displayInActivitySummary="true"
        sortOrder="1"
        precision="1"
        dataLabel="@Strings.wbalMinLabel"
        unitLabel="@Strings.kjUnits" />

        <fitField id="2"
        displayInActivityLaps="true"
        sortOrder="2"
        precision="1"
        dataLabel="@Strings.wbalMinLabel"
        unitLabel="@Strings.kjUnits" />
    </fitContributions>
</resources>
